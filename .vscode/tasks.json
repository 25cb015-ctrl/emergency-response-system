{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-std=c11", "-Wall", "-Wextra", "-g", "-Iinclude",
        "src/main.c", "src/heap.c", "src/hashtable.c",
        "src/graph.c", "src/linkedlist.c",
        "-o", "build/emergency"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "dependsOn": "make-build-dir"
    },
    {
      "label": "make-build-dir",
      "type": "shell",
      "command": "mkdir",
      "args": ["-p", "build"],
      "windows": { "command": "cmd", "args": ["/c", "if not exist build mkdir build"] },
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "build tests",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-std=c11", "-Wall", "-Wextra", "-g", "-Iinclude",
        "tests/test_dsa.c", "src/heap.c", "src/hashtable.c",
        "src/graph.c", "src/linkedlist.c",
        "-o", "build/test_dsa"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "dependsOn": "make-build-dir"
    }
  ]
}
